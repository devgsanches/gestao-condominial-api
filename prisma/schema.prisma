generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CONDOMINIUM_MANAGER
  CONDOMINIUM_ADMIN
  RESIDENT
}

enum AppointmentType {
  MEETING
  ASSEMBLY
}

enum MaintenanceType {
  GENERAL
  PERIODIC
}

enum MaintenancePeriodicity {
  MONTH
  TRIMESTER
  SEMESTER
}

model User {
  id       String   @id @default(uuid())
  name     String
  role     UserRole
  email    String   @unique
  password String
  avatarUrl String? @map("avatar_url")

  condominiums Condominium[]
  adminCondominiums CondominiumAdmin[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Address {
  id           String  @id @default(uuid())
  zipCode      String  @map("zip_code")
  street       String
  number       Int
  complement   String?
  neighborhood String
  city         String
  state        String
  country      String

  condominium Condominium?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("address")
}

model Condominium {
  id        String @id @default(uuid())
  name      String @unique
  slug      String @unique
  managerId String @map("manager_id")
  addressId String @unique @map("address_id")
  unitsCount Int?  @map("units_count")

  manager User @relation(fields: [managerId], references: [id], onDelete: Cascade)
  address Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  maintenances Maintenance[]
  finances     CondominiumFinance[]
  admins       CondominiumAdmin[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("condominiums")
}

model Appointment {
  id             String          @id @default(uuid())
  condominiumId  String          @map("condominium_id")
  type           AppointmentType
  title          String
  description    String
  location       String?
  scheduledAt    DateTime        @map("scheduled_at")
  canceledAt     DateTime?       @map("canceled_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([condominiumId, scheduledAt], where: { canceledAt: null })
  @@map("appointments")
}

model Maintenance {
  id            String                  @id @default(uuid())
  condominiumId String                  @map("condominium_id")
  type          MaintenanceType
  periodicity   MaintenancePeriodicity?
  title         String
  description   String
  scheduledAt   DateTime                @default(now()) @map("scheduled_at")
  canceledAt    DateTime?               @map("canceled_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  contract    Contract?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("maintenances")
}

model Contract {
  id               String   @id @default(uuid())
  maintenanceId    String   @unique @map("maintenance_id")
  title            String?
  slug             String   @unique
  description      String?
  supplierName     String   @map("supplier_name")
  supplierCnpj     String   @map("supplier_cnpj")
  valueInCents     Int      @map("value_in_cents")
  isValid          Boolean  @default(true) @map("is_valid")
  startVigencyDate DateTime @map("start_vigency_date")
  endVigencyDate   DateTime @map("end_vigency_date")

  maintenance Maintenance          @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  attachments ContractAttachment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contracts")
}

model Finance {
  id    String  @id @default(uuid())
  value Decimal

  condominiums CondominiumFinance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("finances")
}

model CondominiumAdmin {
  id            String @id @default(uuid())
  condominiumId String @map("condominium_id")
  adminId       String @map("admin_id")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  admin       User        @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([condominiumId, adminId])
  @@map("condominium_admins")
}

model CondominiumFinance {
  id            String @id @default(uuid())
  condominiumId String @map("condominium_id")
  financeId     String @map("finance_id")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  finance     Finance     @relation(fields: [financeId], references: [id], onDelete: Cascade)

  @@map("condominium_finance")
}

model Attachment {
  id    String @id @default(uuid())
  title String
  url  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contracts ContractAttachment[]

  @@map("attachments")
}

model ContractAttachment {
  id           String @id @default(uuid())
  contractId   String @map("contract_id")
  attachmentId String @map("attachment_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contract   Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@map("contracts_attachments")
}

model AuthCode {
  id        String    @id @default(uuid())
  email     String
  code      String
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("auth_codes")
}
