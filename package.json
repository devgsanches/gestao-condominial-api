{
	"name": "api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.23.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/engines",
			"@swc/core",
			"prisma"
		],
		"ignoredBuiltDependencies": [
			"@scarf/scarf"
		]
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/infra/main",
		"test": "vitest run --config ./vitest.config.ts",
		"test:watch": "vitest --config ./vitest.config.ts",
		"test:cov": "vitest run --config ./vitest.config.ts --coverage",
		"test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts",
		"test:e2e:watch": "vitest --config ./vitest.config.e2e.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1157.0",
		"@faker-js/faker": "^10.6.0",
		"@nestjs-modules/mailer": "^4.0.0",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^11.0.1",
		"@nestjs/jwt": "^12.0.5",
		"@nestjs/microservices": "^11.2.8",
		"@nestjs/passport": "^12.0.2",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/swagger": "^12.0.2",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"amqp-connection-manager": "^5.0.1",
		"amqplib": "^2.2.0",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"date-fns": "^4.4.0",
		"handlebars": "^4.7.10",
		"ioredis": "^6.0.0",
		"nodemailer": "^10.3.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/core": "^1.16.2",
		"@types/express": "^5.0.0",
		"@types/multer": "^2.3.0",
		"@types/node": "^22.10.7",
		"@types/nodemailer": "^8.0.2",
		"@types/passport-jwt": "^4.0.1",
		"@types/passport-local": "^1.0.38",
		"@types/supertest": "^6.0.2",
		"@vitest/coverage-v8": "^5.0.2",
		"dotenv": "^18.0.7",
		"globals": "^16.0.0",
		"prisma": "^7.10.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.1",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^5.0.2"
	}
}