# CMD + \ = split screen to view response on a side
@baseUrl = http://localhost:3333
@authToken = {{authenticate.response.body.access_token}}

# @name healthCheck
GET {{baseUrl}}

###

# @name createAccount
POST {{baseUrl}}/v1/accounts
Content-Type: application/json

{
	"name": "John Doe",
	"email": "johndoe@example.com",
	"password": "123456"
}

###

# @name authenticate
POST {{baseUrl}}/v1/sessions
Content-Type: application/json

{
	"email": "claudia@email.com",
	"password": "1q2w3e4r"
}

###

# Addresses routes

# @name createAddress
POST {{baseUrl}}/v1/addresses
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"zipCode": "01001-000",
	"street": "Praça da Sé",
	"number": 100,
	"complement": "Bloco A",
	"neighborhood": "Sé",
	"city": "São Paulo",
	"state": "SP",
	"country": "Brasil"
}

###

# Condominiums routes

# @name createCondominium
POST {{baseUrl}}/v1/condominium
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"managerId": "00000000-0000-0000-0000-000000000001",
	"addressId": "00000000-0000-0000-0000-000000000002",
	"name": "Residencial Jardim das Flores"
}
