# CMD + \ = split screen to view response on a side
@baseUrl = http://localhost:3333
@authToken = {{authenticate.response.body.access_token}}
@firstAccessToken = {{verifyFirstAccessCode.response.body.access_token}}
@addressId = {{createAddress.response.body.address.id}}
@condominiumId = {{createCondominium.response.body.condominium.id}}
@maintenanceId = {{createMaintenance.response.body.maintenance.id}}
@contractId = {{createContract.response.body.contract.id}}
@appointmentId = {{scheduleMeeting.response.body.appointment.id}}
@attachmentId = {{uploadAttachment.response.body.attachmentId}}

###

# Health

# @name healthCheck
GET {{baseUrl}}

###

# Sessions

# @name authenticate
POST {{baseUrl}}/v1/sessions
Content-Type: application/json

{
	"email": "claudia@email.com",
	"password": "1q2w3e4r"
}

###

# Primeiro acesso - 1. Envia um código de 4 dígitos por e-mail.
# Resposta neutra (202) mesmo se o e-mail não existir; reenvio liberado a cada 60s.
# Local: veja o e-mail no Mailpit em http://localhost:8025

# @name requestFirstAccessCode
POST {{baseUrl}}/v1/sessions/first-access
Content-Type: application/json

{
	"email": "claudia@email.com"
}

###

# Primeiro acesso - 2. Valida o código e devolve um access_token.
# Expira em 15 min e bloqueia após 5 tentativas erradas.

# @name verifyFirstAccessCode
POST {{baseUrl}}/v1/sessions/first-access/verify
Content-Type: application/json

{
	"email": "claudia@email.com",
	"code": "0000"
}

###

# Accounts

# @name createAccount
POST {{baseUrl}}/v1/accounts
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"name": "John Doe",
	"email": "johndoe@example.com",
	"password": "123456"
}

###

# Primeiro acesso - 3. Define a senha com o token do passo anterior.

# @name setManagerPassword
PATCH {{baseUrl}}/v1/accounts/manager/password
Content-Type: application/json
Authorization: Bearer {{firstAccessToken}}

{
	"password": "1q2w3e4r"
}

###

# @name getManagerProfile
GET {{baseUrl}}/v1/accounts/manager/profile
Authorization: Bearer {{authToken}}

###

# @name createManagerAvatar
POST {{baseUrl}}/v1/accounts/manager/profile
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"attachmentId": "{{attachmentId}}"
}

###

# Addresses

# @name createAddress
POST {{baseUrl}}/v1/addresses
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"zipCode": "01001-000",
	"street": "Praça da Sé",
	"number": 100,
	"complement": "Bloco A",
	"neighborhood": "Sé",
	"city": "São Paulo",
	"state": "SP",
	"country": "Brasil"
}

###

# Condominiums

# @name createCondominium
POST {{baseUrl}}/v1/condominium
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"addressId": "{{addressId}}",
	"name": "Residencial Jardim das Flores",
	"unitsCount": 48
}

###

# Cada item traz unitsCount e periodicWithoutContractCount.

# @name fetchCondominiums
GET {{baseUrl}}/v1/condominium
Authorization: Bearer {{authToken}}

###

# Endereço completo, unitsCount, validContractsCount, próximo agendamento e periódicas sem contrato.

# @name getCondominium
GET {{baseUrl}}/v1/condominium/{{condominiumId}}
Authorization: Bearer {{authToken}}

###

# @name getCondominiumDashboard
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/dashboard
Authorization: Bearer {{authToken}}

###

# @name updateCondominium
PATCH {{baseUrl}}/v1/condominium/{{condominiumId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"name": "Residencial Jardim das Flores Atualizado",
	"unitsCount": 52
}

###

# @name deleteCondominium
DELETE {{baseUrl}}/v1/condominium/{{condominiumId}}
Authorization: Bearer {{authToken}}

###

# Maintenances

# @name createMaintenance
POST {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"type": "PERIODIC",
	"periodicity": "month",
	"title": "Manutenção do elevador",
	"description": "Revisão mensal do elevador social",
	"scheduledAt": "2026-11-05T09:00:00.000Z"
}

###

# Paginada (20 por página), canceladas por último.
# Resposta: { maintenances: [...contractStatus, scheduledAt], meta: { page, perPage, total } }

# @name fetchMaintenances
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances
Authorization: Bearer {{authToken}}

###

# @name fetchMaintenancesPage2
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances?page=2
Authorization: Bearer {{authToken}}

###

# @name fetchMaintenancesByType
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances?type=PERIODIC
Authorization: Bearer {{authToken}}

###

# @name fetchMaintenancesByTitle
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances?title=elevador
Authorization: Bearer {{authToken}}

###

# Periódicas ativas sem contrato

# @name fetchMaintenancesWithoutContract
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances?withoutContract=true
Authorization: Bearer {{authToken}}

###

# Detalhe com contrato e documentos anexados

# @name getMaintenance
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances/{{maintenanceId}}
Authorization: Bearer {{authToken}}

###

# @name updateMaintenance
PUT {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances/{{maintenanceId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"title": "Manutenção do elevador - atualizado",
	"description": "Revisão mensal do elevador social e de serviço"
}

###

# @name cancelMaintenance
PATCH {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances/{{maintenanceId}}/cancel
Authorization: Bearer {{authToken}}

###

# Contracts
# Só para manutenções periódicas. title/description são opcionais; o CNPJ é salvo só com dígitos.

# @name createContract
POST {{baseUrl}}/v1/condominium/{{condominiumId}}/maintenances/{{maintenanceId}}/contracts
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"title": "Contrato de manutenção do elevador",
	"description": "Contrato anual de manutenção preventiva",
	"supplierName": "Elevadores Atlas Ltda",
	"supplierCnpj": "12.345.678/0001-90",
	"valueInCents": 150000,
	"startVigencyDate": "2026-01-01T00:00:00.000Z",
	"endVigencyDate": "2026-12-31T23:59:59.000Z"
}

###

# Adiciona documentos sem remover os já vinculados. Resposta traz os anexos com title, url e createdAt.

# @name attachContractDocument
POST {{baseUrl}}/v1/contracts/{{contractId}}/attachments
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"attachmentsIds": ["{{attachmentId}}"]
}

###

# Attachments

# @name uploadAttachment
POST {{baseUrl}}/v1/attachments
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="sample-upload.png"
Content-Type: image/png

< ./test/e2e/sample-upload.png
--boundary--

###

# Appointments
# A listagem devolve { canceled, completed, upcoming }

# @name scheduleMeeting
POST {{baseUrl}}/v1/condominium/{{condominiumId}}/appointments
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"type": "meeting",
	"title": "Reunião de síndicos",
	"description": "Alinhamento mensal sobre manutenções",
	"location": "Salão de festas",
	"scheduledAt": "2026-11-15T19:00:00.000Z"
}

###

# @name scheduleAssembly
POST {{baseUrl}}/v1/condominium/{{condominiumId}}/appointments
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"type": "assembly",
	"title": "Assembleia ordinária",
	"description": "Prestação de contas do condomínio",
	"location": "Salão de festas",
	"scheduledAt": "2026-12-10T19:00:00.000Z"
}

###

# @name fetchAppointments
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/appointments
Authorization: Bearer {{authToken}}

###

# @name fetchAppointmentsByType
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/appointments?type=meeting
Authorization: Bearer {{authToken}}

###

# @name fetchAppointmentsByTitle
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/appointments?title=Reunião
Authorization: Bearer {{authToken}}

###

# @name getAppointment
GET {{baseUrl}}/v1/condominium/{{condominiumId}}/appointments/{{appointmentId}}
Authorization: Bearer {{authToken}}

###

# @name cancelAppointment
PATCH {{baseUrl}}/v1/condominium/{{condominiumId}}/appointments/{{appointmentId}}/cancel
Authorization: Bearer {{authToken}}
